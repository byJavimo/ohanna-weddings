---
import HeroSlider from './HeroSlider.jsx';
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const images = ['/images/boda_mesas.jpeg', '/images/ruta_boda.jpeg', '/images/copas_champagne.jpeg'];
const titleWords = t('hero.title').split(' ');
---
<section class="relative h-[100svh] min-h-[620px] flex items-end overflow-hidden">
  <div class="absolute inset-0 parallax-layer" data-parallax="0.12">
    <div class="absolute -inset-y-24 inset-x-0">
      <HeroSlider client:load images={images} />
    </div>
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/25 to-ink/10 z-[1]"></div>

  <div class="relative z-10 w-full px-6 md:px-12 pb-16 md:pb-20">
    <div class="mx-auto max-w-7xl">
      <p class="overflow-hidden">
        <span class="block font-sans text-[11px] md:text-xs tracking-[0.35em] uppercase text-ivory/85" data-reveal style="--reveal-index:0; transition-delay:0.05s">
          {t('hero.eyebrow')}
        </span>
      </p>
      <h1 class="mt-5 font-serif text-ivory leading-[0.95] text-[13vw] md:text-[9vw] lg:text-[7.5vw] tracking-tight" data-reveal-group>
        {titleWords.map((word, i) => (
          <span class="inline-block overflow-hidden align-bottom mr-[0.28em]">
            <span class="inline-block" data-reveal style={`transition-delay:${0.15 + i * 0.09}s`}>{word}</span>
          </span>
        ))}
      </h1>
      <div class="mt-8 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <p class="font-sans text-xs md:text-sm tracking-[0.3em] uppercase text-ivory/75" data-reveal style="transition-delay:0.5s">
          {t('hero.location')}
        </p>
        <p class="max-w-sm text-ivory/85 text-base md:text-lg font-light leading-relaxed" data-reveal style="transition-delay:0.6s">
          {t('hero.subtitle')}
        </p>
        <a
          href={`/${lang}/#contact`}
          class="group inline-flex items-center gap-3 self-start rounded-full border border-ivory/40 px-7 py-3 text-sm tracking-wide text-ivory transition-colors hover:bg-ivory hover:text-ink"
          data-reveal
          style="transition-delay:0.7s"
        >
          {t('hero.cta')}
          <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 text-ivory/70" data-reveal style="transition-delay:0.9s">
    <span class="h-10 w-px bg-ivory/50 animate-[scrollhint_2s_ease-in-out_infinite]"></span>
  </div>
</section>

<style>
  @keyframes scrollhint {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; transform-origin: top; }
    50% { transform: scaleY(1); opacity: 1; transform-origin: top; }
  }
</style>
