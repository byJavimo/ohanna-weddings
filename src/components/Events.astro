---
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const services = ['privados', 'corporativos'] as const;
---
<section id="events" class="relative mx-auto max-w-4xl px-6 py-24 md:py-32 text-center overflow-hidden">
  <span class="pointer-events-none absolute -top-6 left-1/2 -translate-x-1/2 font-serif text-[30vw] md:text-[14vw] leading-none text-champagne/25 select-none" aria-hidden="true">03</span>
  <div class="relative">
    <h2 class="font-serif text-4xl md:text-6xl text-ink" data-reveal>{t('events.title')}</h2>
    <p class="mt-8 text-taupe leading-relaxed text-lg font-light" data-reveal>{t('events.intro1')}</p>
    <p class="mt-6 text-taupe leading-relaxed text-lg font-light" data-reveal style="transition-delay:0.08s">{t('events.intro2')}</p>
    <p class="mt-6 font-serif italic text-2xl text-ink" data-reveal style="transition-delay:0.16s">{t('events.intro3')}</p>
  </div>
</section>

<section class="bg-white border-y border-border">
  <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="text-center max-w-xl mx-auto">
      <h3 class="font-serif text-3xl md:text-4xl text-ink" data-reveal>{t('events.servicesTitle')}</h3>
    </div>
    <div class="mt-16 grid gap-8 md:grid-cols-2" data-reveal-group>
      {services.map((key) => (
        <div class="group rounded-3xl border border-border p-9 shadow-soft bg-ivory transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_20px_60px_rgba(140,122,107,0.18)]" data-reveal>
          <h4 class="font-serif text-2xl text-ink transition-transform duration-500 group-hover:translate-x-1">{t(`events.${key}.title`)}</h4>
          <p class="mt-2 text-sm italic text-taupe">{t(`events.${key}.tagline`)}</p>
          <p class="mt-4 text-sm text-taupe leading-relaxed whitespace-pre-line">{t(`events.${key}.description`)}</p>
          {t(`events.${key}.includes`) !== `events.${key}.includes` && (
            <p class="mt-4 text-xs tracking-wide uppercase text-taupe/80">{t(`events.${key}.includes`)}</p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
