---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import ImageBreak from '../../components/ImageBreak.astro';
import Weddings from '../../components/Weddings.astro';
import Events from '../../components/Events.astro';
import Inspiration from '../../components/Inspiration.astro';
import ContactForm from '../../components/ContactForm.jsx';
import { useTranslations, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: 'es' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---
<Layout lang={lang} title={t('meta.title')} description={t('meta.description')}>
  <Hero lang={lang} />
  <About lang={lang} />
  <ImageBreak src="/images/bienvenidos_a_boda.jpeg" alt="" />
  <Weddings lang={lang} />
  <Events lang={lang} />
  <ImageBreak src="/images/ruta_boda.jpeg" alt="" height="lg" />
  <Inspiration lang={lang} />
  <ContactForm client:visible lang={lang} />
</Layout>
